{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Straylight",
  "version": "0.12.1",
  "identifier": "dev.straylight.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Straylight",
        "width": 1400,
        "height": 900,
        "minWidth": 600,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "backgroundColor": "#151013",
        "dragDropEnabled": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Yooouuuuuuu/straylight/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwMTA1MkNDNDY3RTZDOUMKUldTY2JINUd6RklRc0dQWEpiaXF6S3JiTG9BZGZieTZ1L3drSEdxejYxOUVLZ3FicDNrZnN3YjcK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Lightweight SSH file manager, terminal, and code viewer",
    "longDescription": "Straylight is a lightweight desktop app for remote server work over SSH. Browse remote files, read code with syntax highlighting, and use a full terminal — all in a fast, native window built with Tauri."
  }
}
